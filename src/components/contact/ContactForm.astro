---
---
<div class="bg-zinc-100 p-6 border rounded-lg">
  <h3 class="text-xl font-bold mb-4">Envíanos un mensaje</h3>
  <form class="space-y-4">
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="space-y-2">
        <label for="name" class="text-sm font-medium">Nombre</label>
        <input id="name" class="w-full px-3 py-2 bg-white rounded-md border border-zinc-300 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Tu nombre" />
      </div>
      <div class="space-y-2">
        <label for="email" class="text-sm font-medium">Email</label>
        <input id="email" type="email" class="w-full px-3 py-2 bg-white rounded-md border border-zinc-300 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="tu@email.com" />
      </div>
    </div>

    <div class="space-y-2">
      <label for="subject" class="text-sm font-medium">Asunto</label>
      <input id="subject" class="w-full px-3 py-2 bg-white rounded-md border border-zinc-300 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Asunto del mensaje" />
    </div>

    <div class="space-y-2">
      <label for="message" class="text-sm font-medium">Mensaje</label>
      <textarea id="message" rows="4" class="w-full px-3 py-2 bg-white rounded-md border border-zinc-300 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Escribe tu mensaje aquí..."></textarea>
    </div>

    <button
      type="submit"
      class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium h-10 px-4 w-full text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors hover:opacity-90"
      style="background-color: rgb(24,42,59);"
    >
      Enviar Mensaje
    </button>
  </form>
</div>
