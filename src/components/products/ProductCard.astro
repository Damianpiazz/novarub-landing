---
import { Download } from 'lucide-react'

const { title, description, image } = Astro.props
---

<div class="rounded-lg bg-white text-black shadow hover:shadow-md overflow-hidden border border-gray-200 transition-all">
  <div class="relative h-48 bg-zinc-200">
    <img src={image} alt={title} class="object-cover w-full h-full" />
  </div>
  <div class="p-6">
    <h3 class="text-xl font-bold mb-2 text-black">{title}</h3>
    <p class="text-gray-700 mb-4">{description}</p>
    <a href="/novarub-landing/catalogo.pdf" download>
      <button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium h-9 rounded-md px-3 border bg-white text-black border-gray-300 hover:bg-muted">
        <Download className="w-4 h-4" />
        <span>Ver mas</span>
      </button>
    </a>
  </div>
</div>
