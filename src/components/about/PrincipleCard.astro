---
const { icon: Icon, title, text } = Astro.props;
---

<div class="flex flex-col items-center text-center p-6 rounded-2xl bg-muted hover:bg-muted/80 transition">
  <Icon class="w-10 h-10 text-primary mb-4" />
  <h4 class="text-lg font-semibold mb-2">{title}</h4>
  <p class="text-sm text-muted-foreground">{text}</p>
</div>
