---
import { Target, Eye, Heart } from "lucide-react";

const principles = [
  {
    icon: Target,
    title: "Misión",
    description:
      "Diseñamos soluciones de curado y armado, priorizando relaciones honestas con clientes y proveedores.",
  },
  {
    icon: Eye,
    title: "Visión",
    description:
      "Buscamos liderar la innovación tecnológica y expandirnos como referentes en servicios para la industria del neumático.",
  },
  {
    icon: Heart,
    title: "Valores",
    description:
      "Nos guiamos por la planificación, la mejora continua, la innovación, la calidad y el compromiso ambiental.",
  },
];
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
  {principles.map(({ icon: Icon, title, description }) => (
    <div class="flex flex-col p-8 bg-muted rounded-lg">
      <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-6">
        <Icon className="h-6 w-6 text-primary" />
      </div>
      <h3 class="text-xl font-bold mb-4">{title}</h3>
      <p class="text-muted-foreground">{description}</p>
    </div>
  ))}
</div>
